#!/bin/sh
[ "$TMUX" ] && exec fzf-tmux "$@"

tmpdir=$(mktemp -dt menu.XXXXXX)
trap 'rm -rf "$tmpdir"' EXIT

infifo="$tmpdir/in"
outfifo="$tmpdir/out"
mkfifo "$infifo" "$outfifo"

# Use a copy of stdin because background jobs change fd 0.
exec 3<&0
cat <&3 >"$infifo" &
cat "$outfifo" &

foot -a menu sh -c "fzf $* < '$infifo' > '$outfifo'"

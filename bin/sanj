#!/usr/bin/bash
# Syntactic sugar for llm command.

BASE_SYSTEM='Output is redirected to terminal, format accordingly.'
GENERATE_COMMAND_SYSTEM=(
    'Provide only bash commands for debian without any description.'
    'If there is a lack of details, provide most logical solution.'
    'Ensure the output is a valid shell command.'
    'If multiple steps required try to combine them together using &&.'
    'Provide only plain text without Markdown formatting.'
    'Do not provide markdown formatting such as backticks.'
)
LOOP_SYSTEM=(
    'You are an AI agent. Complete complicated tasks by using the "command" keyword.'
    'Everything in your response following a line with only the word "command" in it'
    'will be executed as is (so no formatting or fencing) on a bash shell'
    'of the hosting debian system. The output along with the complete history'
    'will be passed back to you.'
)

sanj() {
    # Default action is chat.
    # `do` keyword changes to "do".
    # A lone dash changes to "dump".
    # Triple dashes change to "loop".
    local action=chat
    # The following will be appended to `BASE_SYSTEM` if provided:
    # 1) `GENERATE_COMMAND_SYSTEM` for `do` commands.
    # 2) Anything after `--`.
    # 3) Any provided prompt if input is piped in.
    # 4) `LOOP_SYSTEM` for `loop` commands.
    local system_prompts=("${BASE_SYSTEM[@]}")
    local prompt  # Prompt to send to llm.
    local llm_arguments=()  # Pass through arguments to llm.

    # Scan arguments, giving `do` special treatment.
    if [ "$1" = 'do' ]; then
        shift
        action='do'
        system_prompts+=("${GENERATE_COMMAND_SYSTEM[@]}")
    fi
    local argument_index=1
    while [ $argument_index -le $# ]; do
        case "${!argument_index}" in
            -) action=dump;;
            --) system_prompts+=("${@:$((argument_index + 1))}"); break;;
            ---) action=loop;;
            -*)
                llm_arguments+=("${!argument_index}")
                argument_index=$((argument_index + 1))
                llm_arguments+=("${!argument_index}")
                ;;
            *)
                if [ -f "${!argument_index}" ]; then
                    llm_arguments+=("--fragment" "${!argument_index}")
                else
                    prompt+=" ${!argument_index}"
                fi
                ;;
        esac
        argument_index=$((argument_index + 1))
    done

    # If input is being piped in, assume it will be the prompt and the provided prompt is the system prompt.
    if [ ! -t 0 ]; then
        system_prompts+=("$prompt")
        prompt=''
    fi

    llm_arguments+=("--system" "${system_prompts[*]}")

    if [ $action = dump ]; then
        llm "${llm_arguments[@]}" "$prompt"
    elif [ $action = 'do' ]; then
        response="$(llm "${llm_arguments[@]}" "$prompt")"
        echo "$response"
        read -r
        ydotool type -d0 "$response"
    elif [ $action = chat ]; then
        if [ "$prompt" ]; then
            (
                sleep 1
                ydotool type -d0 "$prompt"
                ydotool key -d0 28:1
                ydotool key -d0 28:0
            ) &
        fi
        llm chat "${llm_arguments[@]}"
    elif [ $action = loop ]; then
        system_prompts+=("${LOOP_SYSTEM[@]}")
        while true; do
            response="$(llm "${llm_arguments[@]}" "$prompt")"
            printf "\n=== Response ===\n%s\n" "$response"
            command="$(sed -n '/^command$/,$p' <<<"$response" | tail -n +2)"
            [ -z "$command" ] && break
            read -rp "Execute command: $command ? (y/n) " yn
            [ "$yn" != y ] && break
            output="$(eval "$command" 2>&1)"
            prompt="$prompt\nresponse:\n$response\noutput:\n$output\n\n"
        done
        return 0
    fi
}

# Don't do anything if sourced.
[ "${BASH_SOURCE[0]}" != "$0" ] && return 0

sanj "$@"
